{
  "name": "@moritzbrantner/storytelling",
  "version": "0.5.0",
  "description": "Serializable story documents, branching React playback, and Remotion or Three adapters.",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/storytelling.git"
  },
  "license": "MIT",
  "files": [
    "dist",
    "docs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./remotion": {
      "types": "./dist/remotion.d.ts",
      "import": "./dist/remotion.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.js"
    }
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.379",
    "three": "^0.180.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "remotion": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "dependencies": {
    "@moritzbrantner/ui": "^0.8.0",
    "motion": "^12.35.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@react-three/fiber": "^9.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.379",
    "three": "^0.180.0",
    "tsup": "^8.5.0",
    "typescript": "6.0.2",
    "vite": "^8.0.14",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config example/vite.config.ts",
    "build:example": "vite build --config example/vite.config.ts",
    "build": "tsup src/index.ts src/core.ts src/schema.ts src/remotion.tsx src/three.tsx src/media.tsx src/workflow.ts src/timeline.ts --format esm --dts --clean --out-dir dist",
    "check-types": "tsc --noEmit",
    "lint": "oxfmt --check && oxlint --format=github && node scripts/verify-package-imports.mjs ./src @/ next/ next-intl",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:package": "node scripts/verify-package.mjs",
    "test:consumer": "node scripts/verify-consumer.mjs",
    "test:published": "node scripts/verify-published-package.mjs",
    "pack:dry": "npm pack --dry-run --ignore-scripts --json",
    "prepack": "bun run build",
    "verify": "bun run lint && bun run check-types && bun run test && bun run build && bun run build:example && bun run test:e2e && bun run test:package && bun run test:consumer && bun run pack:dry",
    "publish:package": "node scripts/publish-if-new.mjs"
  }
}
