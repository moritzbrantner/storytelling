{
  "name": "@moritzbrantner/storytelling",
  "version": "0.5.0",
  "description": "Serializable story documents, branching React playback, and Remotion or Three adapters.",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/storytelling.git"
  },
  "license": "MIT",
  "files": [
    "dist",
    "docs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./remotion": {
      "types": "./dist/remotion.d.ts",
      "import": "./dist/remotion.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.js"
    },
    "./adapters/markdown": {
      "types": "./dist/adapters-markdown.d.ts",
      "import": "./dist/adapters-markdown.js"
    },
    "./adapters/charts": {
      "types": "./dist/adapters-charts.d.ts",
      "import": "./dist/adapters-charts.js"
    }
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.379",
    "three": "^0.180.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "remotion": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "dependencies": {
    "@moritzbrantner/timeline-editor": "^1.0.0",
    "@moritzbrantner/ui": "^0.8.0",
    "motion": "^12.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-istanbul": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "fast-check": "^4.8.0",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.67.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "^4.0.470",
    "three": "^0.180.0",
    "tinybench": "^6.0.2",
    "tsup": "^8.5.1",
    "typescript": "6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config example/vite.config.ts",
    "build:example": "vite build --config example/vite.config.ts",
    "build": "tsup src/index.ts src/core.ts src/schema.ts src/remotion.tsx src/three.tsx src/media.tsx src/workflow.ts src/timeline.ts src/adapters-markdown.ts src/adapters-charts.ts --format esm --dts --clean --out-dir dist --minify-whitespace",
    "check-types": "tsc --noEmit",
    "lint": "oxfmt --check && oxlint --format=github && bun scripts/verify-package-imports.mjs ./src @/ next/ next-intl",
    "test": "bun run test:unit",
    "test:unit": "vitest run src tests --exclude tests/property/**",
    "test:property": "vitest run tests/property",
    "test:coverage": "vitest run src tests --coverage",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "test:e2e": "playwright test",
    "test:package": "bun scripts/verify-package.mjs",
    "test:consumer": "bun scripts/verify-consumer.mjs",
    "test:published": "bun scripts/verify-published-package.mjs",
    "size": "bun run build && bun scripts/check-dist-size.mjs",
    "perf:smoke": "bun run build && bun scripts/run-benchmarks.mjs --profile smoke --budget bench/budgets.smoke.json --out bench/results/smoke.json",
    "perf": "bun run build && bun scripts/run-benchmarks.mjs --profile full --out bench/results/latest.json",
    "perf:compare": "bun scripts/compare-benchmarks.mjs --baseline bench/baselines/main.json --candidate bench/results/latest.json",
    "pack:dry": "npm pack --dry-run --ignore-scripts --json",
    "prepack": "bun run build",
    "verify": "bun run lint && bun run check-types && bun run test:unit && bun run test:property && bun run test:coverage && bun run test:types && bun run build && bun run size && bun run build:example && bun run test:e2e && bun run test:package && bun run test:consumer && bun run pack:dry",
    "publish:package": "bun scripts/publish-if-new.mjs"
  }
}
